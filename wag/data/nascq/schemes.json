{
  "AS:practical_reasoning": {
    "carneades_id": "practical_reasoning1",
    "name": "Practical Reasoning",
    "semantic_type": "action",
    "thesis_independent": false,
    "base_weight": 0.7,
    "variables": {
      "A": {
        "type": "action",
        "description": "Action to be performed",
        "example_en": "introduce a carbon tax"
      },
      "S1": {
        "type": "state",
        "description": "Current circumstances",
        "example_en": "emissions are rising"
      },
      "S2": {
        "type": "state",
        "description": "Future state after action",
        "example_en": "lower emissions"
      },
      "G": {
        "type": "goal",
        "description": "Goal to be realized",
        "example_en": "a stable climate"
      },
      "V": {
        "type": "value",
        "description": "Value promoted by the goal",
        "example_en": "public health"
      }
    },
    "premise_templates_en": [
      "The current situation is {S1}",
      "Doing {A} in the situation {S1} would lead to {S2}",
      "The goal {G} would be achieved in {S2}",
      "Achieving {G} would promote the value {V}"
    ],
    "conclusion_template_en": "{A} should be done",
    "description_en": "An agent should do an action because, in the current circumstances, it brings about a state that realizes a goal, which promotes a value.",
    "cues_en": [
      "should",
      "ought to",
      "we must",
      "in order to",
      "so that",
      "goal",
      "aim",
      "achieve",
      "promote",
      "policy",
      "plan to"
    ],
    "evidence": "",
    "evidence_note_en": ""
  },
  "AS:consequences": {
    "carneades_id": "positive_consequences",
    "name": "Argument from Positive Consequences",
    "semantic_type": "action",
    "thesis_independent": false,
    "base_weight": 0.65,
    "variables": {
      "A": {
        "type": "action",
        "description": "Action",
        "example_en": "introduce a carbon tax"
      },
      "G": {
        "type": "event",
        "description": "Good consequence",
        "example_en": "cleaner air"
      }
    },
    "premise_templates_en": [
      "Doing {A} brings about {G}",
      "{G} is good"
    ],
    "conclusion_template_en": "{A} should be done",
    "description_en": "An action should be performed because it brings about good consequences.",
    "cues_en": [
      "consequence",
      "consequences",
      "would lead to",
      "will lead to",
      "leads to",
      "result in",
      "results in",
      "benefit",
      "benefits",
      "good outcome",
      "because it would"
    ],
    "evidence": "recommended",
    "evidence_note_en": "a source showing the action brings about the consequence"
  },
  "AS:values": {
    "carneades_id": "positive_value",
    "name": "Argument from Values",
    "semantic_type": "value",
    "thesis_independent": false,
    "base_weight": 0.6,
    "variables": {
      "V": {
        "type": "value",
        "description": "Value being invoked",
        "example_en": "fairness"
      },
      "A": {
        "type": "entity",
        "description": "Agent or judger",
        "example_en": "most voters"
      },
      "G": {
        "type": "goal",
        "description": "Goal affected",
        "example_en": "equal pay"
      }
    },
    "premise_templates_en": [
      "{V} is a positive value for {A}",
      "{V} supports the goal {G} for {A}"
    ],
    "conclusion_template_en": "{V} is a reason to keep the goal {G}",
    "description_en": "A goal is worth keeping because it promotes a value the agent holds.",
    "cues_en": [
      "value",
      "values",
      "freedom",
      "fairness",
      "justice",
      "equality",
      "dignity",
      "important to",
      "matters",
      "principle",
      "right thing"
    ],
    "evidence": "",
    "evidence_note_en": ""
  },
  "AS:sign": {
    "carneades_id": "sign",
    "name": "Argument from Sign",
    "semantic_type": "causality",
    "thesis_independent": false,
    "base_weight": 0.6,
    "variables": {
      "A": {
        "type": "event",
        "description": "Observable sign or indicator",
        "example_en": "wet streets"
      },
      "B": {
        "type": "event",
        "description": "Indicated condition",
        "example_en": "it rained"
      }
    },
    "premise_templates_en": [
      "{A} is observed",
      "{B} is indicated when {A} holds"
    ],
    "conclusion_template_en": "{B} holds in the current situation",
    "answer_variable": "B",
    "description_en": "Something is probably true because an observed sign usually indicates it.",
    "cues_en": [
      "sign",
      "signs",
      "indicates",
      "indication",
      "suggests",
      "symptom",
      "evidence of",
      "shows that",
      "points to",
      "observed"
    ],
    "evidence": "recommended",
    "evidence_note_en": "where the sign was observed"
  },
  "AS:expert_opinion": {
    "carneades_id": "credible_source",
    "name": "Argument from Expert Opinion",
    "semantic_type": "truth",
    "thesis_independent": true,
    "base_weight": 0.7,
    "variables": {
      "W": {
        "type": "entity",
        "description": "Expert or credible source",
        "example_en": "the IPCC"
      },
      "D": {
        "type": "domain",
        "description": "Field of expertise",
        "example_en": "climate science"
      },
      "S": {
        "type": "proposition",
        "description": "Proposition asserted",
        "example_en": "human activity is warming the planet"
      }
    },
    "premise_templates_en": [
      "{W} is a credible expert on {D}",
      "{W} says that {S}",
      "{S} is a matter of {D}"
    ],
    "conclusion_template_en": "{S}",
    "answer_variable": "S",
    "description_en": "A claim is plausible because an expert in its field asserts it.",
    "cues_en": [
      "expert",
      "experts",
      "scientist",
      "scientists",
      "according to",
      "study",
      "studies",
      "research",
      "professor",
      "doctor",
      "dr",
      "researchers",
      "ipcc",
      "peer reviewed"
    ],
    "evidence": "required",
    "evidence_note_en": "where the expert asserts it (a citation or a link)"
  },
  "AS:position_to_know": {
    "carneades_id": "position_to_know",
    "name": "Argument from Position to Know",
    "semantic_type": "truth",
    "thesis_independent": true,
    "base_weight": 0.65,
    "variables": {
      "W": {
        "type": "entity",
        "description": "Knowledgeable source",
        "example_en": "a local resident"
      },
      "D": {
        "type": "domain",
        "description": "Domain of knowledge",
        "example_en": "what happens in the village"
      },
      "S": {
        "type": "proposition",
        "description": "Proposition asserted",
        "example_en": "the road floods every spring"
      }
    },
    "premise_templates_en": [
