      "knows",
      "in a position to know",
      "official"
    ],
    "evidence": "required",
    "evidence_note_en": "where they assert it (a citation or a link)"
  },
  "AS:analogy": {
    "carneades_id": "analogy",
    "name": "Argument from Analogy",
    "semantic_type": "truth",
    "thesis_independent": true,
    "base_weight": 0.55,
    "variables": {
      "A": {
        "type": "proposition",
        "description": "Proposition claimed to hold",
        "example_en": "a carbon tax cuts emissions"
      },
      "C": {
        "type": "case",
        "description": "Similar case",
        "example_en": "Sweden's carbon tax"
      }
    },
    "premise_templates_en": [
      "{C} is a similar case",
      "{A} is true in the case of {C}"
    ],
    "conclusion_template_en": "{A}",
    "answer_variable": "A",
    "description_en": "A claim holds here because it holds in a similar case.",
    "cues_en": [
      "like",
      "similar",
      "similarly",
      "just as",
      "analogous",
      "analogy",
      "same as",
      "compare",
      "as in",
      "in the case of",
      "precedent"
    ],
    "evidence": "recommended",
    "evidence_note_en": "the similar case"
  }
}
