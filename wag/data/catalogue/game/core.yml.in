# WAG Core Argumentation Schemes for Carneades-4
#
# The game's schemes (docs/c5-game.md): each game scheme's block is made
# from its catalogue entry, with walton.yml's formulas unless the entry
# records its own (analogy and sign, until their families' steps), and the
# language's sentences are walton.yml's templates or the ones game/language.yml
# records, with the reason each differs. Wyner's credible-source scheme is kept
# for games recorded before 2026-10-13.
#
# Variable names are preserved exactly from the formulas so that
# InstantiateScheme substitution works correctly.

language:
  # How statements read on the board. The players' words are put in single
  # quotes for them (‘carbon tax’), and statements inside statements in
  # double quotes, so these templates need not fit every phrase a player
  # types. A key "¬p/n" is the sentence for the negation of p/n; without one
  # a negation reads "it is not the case that …".
  # @language

argument_schemes:
  # @scheme practical_reasoning1

  # As in walton.yml (Walton 2015): the goal-based scheme, without values
  # (the book's 22.1, practical inference).
  # @scheme practical_reasoning2

  # @scheme positive_consequences

  # As in walton.yml (the book's 33.2): the counterpart of positive
  # consequences; it concludes the opposite of should_be_performed(A), so it
  # argues against what should be done.
  # @scheme negative_consequences

  # @scheme positive_value

  # @scheme sign

  # As in walton.yml (Walton 1997, the book's scheme 2): the game's Argument
  # from Expert Opinion. Its six critical questions are its three premises,
  # its assumption and its two exceptions.
  # @scheme expert_opinion

  # Wyner's variant (2016), kept for games recorded before 2026-10-13.
  - id: credible_source
    meta:
      title: Argument from Credible Source
      source: "Wyner (2016)"
    variables: [W,D,S]
    conclusions: [S]
    premises:
      - credible_source(W,D)
      - asserts(W,S)
      - in_domain(S,D)
    exceptions:
      - biased(W)
      - dishonest(W)
      - other_credible_sources_disagree(S)

  # @scheme position_to_know

  # @scheme analogy

  # The modal variants (D008): an action that may bring about a consequence.
  # Their conclusions bear on the decision only through a bridge.
  # @scheme positive_consequences_modal

  # @scheme negative_consequences_modal

  # The bridges (D008, refined 2026-11-25): from a possible consequence to the
  # action, when its chance matters enough to the decision; a modal argument
  # supports their first premise, and their exception is shared (D053).
  # @scheme bridge_from_possible_good

  # @scheme bridge_from_possible_harm

  # The answer schemes (D075): each concludes the exception it answers and is
  # offered only as that answer (D094 (g)).
  # @scheme bad_outweighs_good

  # @scheme good_outweighs_bad

  # @scheme better_means

  # @scheme finding_out_first
